# =====================================================================
# 환경 파일은 **두 개**다. 이 파일은 둘의 템플릿이다.
#
#   .env.local  — 로컬 개발(supabase start, 643xx 포트). 자동으로 읽힌다.
#   .env.prod   — 원격(배포) 프로젝트를 바라볼 때. `pnpm build:prod`로만 읽힌다.
#
# ⚠ 나뉜 이유는 **Redirect URI가 환경마다 다르기 때문**이다. 콘솔에 등록하는 주소는
#   앱 주소가 아니라 그 환경의 supabase 콜백이다:
#
#       로컬  http://127.0.0.1:64321/auth/v1/callback
#       원격  https://<project-ref>.supabase.co/auth/v1/callback
#
#   ⚠ 이 주소를 만드는 건 아래 NEXT_PUBLIC_SUPABASE_URL이 **아니라** GoTrue 자신의
#     API_EXTERNAL_URL이다. 우리 env는 "앱이 어느 supabase로 가느냐"만 정하고,
#     그 supabase가 자기 주소를 프로바이더에 보낸다 — 값이 같아 보이는 건 결과일 뿐이다.
#     (그래서 이 파일만 채우고 콘솔에 등록하지 않으면 redirect_uri_mismatch가 난다)
#
#   ⚠ **완전 일치**다(localhost ≠ 127.0.0.1, 포트·슬래시까지). 카카오·구글 콘솔에
#     둘 다 등록해 두면 환경을 오갈 때 고칠 필요가 없다.
#   자세한 절차는 docs/oauth-setup.md.
#
# ⚠ 파일 이름을 `.env.production`으로 바꿔도 자동으로 읽히지 않는다 — Next 우선순위에서
#   `.env.local`이 위라 로컬 값이 이긴다. 그래서 `pnpm build:prod`가 명시적으로 싣는다.
# =====================================================================

# ===== Supabase 연결 정보 =====
# 로컬: `supabase start` 출력의 API URL / publishable key
# 원격: 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 관리 작업용 — 런타임에는 필요 없음
SUPABASE_SERVICE_ROLE_KEY=

# ===== 배포 도메인 =====
# 공유 프리뷰 이미지(og:image)의 절대 URL 기준. 비우면 VERCEL_URL → localhost 순으로 폴백한다.
# ⚠ NEXT_PUBLIC_* 는 빌드 시점에 인라인된다 — 런타임에만 주입하면 값이 잡히지 않고
#   아무 경고 없이 localhost가 나간다. 반드시 빌드 환경에 넣을 것.
# 로컬(.env.local)은 비워도 되지만, .env.prod에는 반드시 채운다.
NEXT_PUBLIC_SITE_URL=

# ===== 소셜 로그인 =====
# ⚠ **.env.local 전용이다.** supabase CLI가 config.toml의 env()로 읽어 **로컬 스택의
#   GoTrue**에 넣는 값이라, .env.prod에 적어도 아무 데도 가지 않는다.
#   원격은 대시보드 Authentication → Providers 에 직접 입력한다.
# 값을 바꾼 뒤에는 `supabase stop && supabase start`(db reset 아님)가 필요하다.
#
# 카카오: [앱] > [플랫폼 키] > [REST API 키] / 그 아래 [클라이언트 시크릿]
# 구글  : Google Auth Platform > 클라이언트 > 웹 애플리케이션
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ===== Supabase CLI (마이그레이션 적용용) =====
# ⚠ 이것도 **.env.local 전용이다** — CLI는 .env.prod를 읽지 않는다.
#   `supabase db push`·`db reset --linked`·`config push`는 확인 프롬프트 없이 원격을 바꾼다.
# supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# 경기 일정·라인업·스탯 제공자 (https://dashboard.api-football.com)
# scripts/sync-matches.mjs · sync-match-detail.mjs · fetch-team-crests.mjs가 쓴다
API_FOOTBALL_KEY=
