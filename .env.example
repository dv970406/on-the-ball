# ===== Supabase 연결 정보 =====
# 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 관리 작업용 — 런타임에는 필요 없음
SUPABASE_SERVICE_ROLE_KEY=

# ===== 배포 도메인 =====
# 공유 프리뷰 이미지(og:image)의 절대 URL 기준. 비우면 VERCEL_URL → localhost 순으로 폴백한다.
# ⚠ NEXT_PUBLIC_* 는 빌드 시점에 인라인된다 — 런타임에만 주입하면 값이 잡히지 않고
#   아무 경고 없이 localhost가 나간다. 반드시 빌드 환경에 넣을 것.
NEXT_PUBLIC_SITE_URL=

# ===== Supabase CLI (마이그레이션 적용용) =====
# supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
